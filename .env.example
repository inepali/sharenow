# ═══════════════════════════════════════════════════════════════════════════════
# SUPABASE - SHARED BY FRONTEND & BACKEND
# ═══════════════════════════════════════════════════════════════════════════════

# Frontend uses these with VITE_ prefix for build-time constants
VITE_SUPABASE_PROJECT_ID=your_project_id
VITE_SUPABASE_PUBLISHABLE_KEY=your_anon_key
VITE_SUPABASE_URL=https://your-project.supabase.co

# Backend uses these for runtime API calls
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key

# ═══════════════════════════════════════════════════════════════════════════════
# CLOUDFLARE R2 - FILE STORAGE (USED BY BACKEND)
# ═══════════════════════════════════════════════════════════════════════════════

R2_ACCOUNT_ID=your_account_id
R2_ACCESS_KEY_ID=your_access_key_id
R2_SECRET_ACCESS_KEY=your_secret_access_key
R2_BUCKET_NAME=gallery-photos

# Frontend uses this to display images from R2
R2_PUBLIC_URL_BASE=https://your-account-id.r2.cloudflarestorage.com
R2_PUBLIC_DOMAIN_URL_BASE=https://your-custom-domain.r2.dev
VITE_R2_PUBLIC_URL=https://your-custom-domain.r2.dev

# ═══════════════════════════════════════════════════════════════════════════════
# SERVER CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════════════

# Port for backend API server (runs on http://localhost:3001 in dev)
PORT=3001

# CORS: Which frontend URLs can access this API
# For local dev: http://localhost:5173
# For production: https://yourdomain.com
ALLOWED_ORIGINS=http://localhost:5173,https://yourdomain.com

# Node environment
NODE_ENV=development

# ═══════════════════════════════════════════════════════════════════════════════
# OPTIONAL: EXTERNAL INTEGRATIONS
# ═══════════════════════════════════════════════════════════════════════════════

DROPBOX_ACCESS_TOKEN=your_dropbox_token
GOOGLE_API_KEY=your_google_api_key

# ═══════════════════════════════════════════════════════════════════════════════
# SETTINGS
# ═══════════════════════════════════════════════════════════════════════════════

SETTINGS_FILE=./settings.json
